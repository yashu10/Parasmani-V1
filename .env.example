# Public site URL (no trailing slash). Used for canonical, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.parasmaniengineering.com

# Set to 1 ONLY on the final production domain. Anything else = noindex + Disallow: /
NEXT_PUBLIC_ALLOW_INDEXING=0

# 1 = show content/badges that are still "pending client verification". Keep 1 for previews.
NEXT_PUBLIC_SHOW_PENDING=1

# 1 = show Careers in nav/footer and sitemap.
NEXT_PUBLIC_SHOW_CAREERS=1

# image (default) | 3d  -> 3d lazy-loads three.js
NEXT_PUBLIC_BG_MODE=image

# Base URL of the RDSO PDFs (or copy PDFs to /public/rdso and use /rdso/)
NEXT_PUBLIC_RDSO_BASE=https://www.parasmaniengineering.com/public/rdso-documents/

# RFQ form (Resend)
RESEND_API_KEY=
RFQ_TO_EMAIL=info@parasmaniengineering.com
# Must be a sender verified in Resend, e.g. "PEPL Website <rfq@yourdomain.com>"
RFQ_FROM_EMAIL=PEPL Website <onboarding@resend.dev>
